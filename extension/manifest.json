{
  "manifest_version": 3,
  "name": "EoneRouter",
  "version": "0.1.0",
  "description": "Attach X-Eone-Id and Swimlane so the preview origin and page Fetch/XHR use the selected eone id.",
  "action": {
    "default_title": "EoneRouter",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage", "declarativeNetRequestWithHostAccess", "proxy"],
  "optional_host_permissions": ["http://*/*", "https://*/*"]
}
